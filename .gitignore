# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Credentials / environment
.env
.env.*
!.env.example
.cdsapirc
*.pem
*.key

# marimo caches / exports
.marimo/
__marimo__/
reports/html/

# Research data: NEVER commit raw or intermediate datasets
/data/raw/*
!/data/raw/.gitkeep
/data/external/*
!/data/external/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/cache/*
!/data/cache/.gitkeep

# Typical large geoscience formats anywhere else
*.nc
*.nc4
*.grib
*.grib2
*.tif
*.tiff
*.zarr/
*.gpkg
*.parquet
*.feather
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Saídas geradas: PNG e tabelas são versionados; PDF e a cópia da Overleaf, não
reports/tmp/
reports/figures/**/*.pdf
reports/overleaf/

# Slurm / execução no HPC
logs/
slurm-*.out
site/
