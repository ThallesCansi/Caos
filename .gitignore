# Research data: NEVER commit raw or intermediate datasets
/data/*.zip
/data/raw/*
!/data/raw/.gitkeep
/data/external/*
!/data/external/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/cache/*
!/data/cache/.gitkeep

