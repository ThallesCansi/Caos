*.nc
*.nc4
*.grib
*.grib2
*.tif
*.tiff
*.zarr/
*.gpkg
*.parquet
*.feather
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Saídas geradas: PNG e tabelas são versionados; PDF e a cópia da Overleaf, não
reports/tmp/
reports/figures/**/*.pdf
reports/overleaf/

# PDFs de apoio à orientação (rascunhos locais)
